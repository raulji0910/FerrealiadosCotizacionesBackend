# Copiar este archivo como ".env" y ajustar los valores.
# Los de abajo son válidos solo para desarrollo local.
SA_PASSWORD=YourStrong!Passw0rd
JWT_SECRET=CAMBIAR-ESTE-SECRETO-EN-PRODUCCION-min-32-caracteres-1234567890

# Ruta en el host donde está el Excel de origen para la migración inicial (carpeta, no el archivo).
EXCEL_SOURCE_DIR=C:\ruta\a\la\carpeta\del\excel

# Correo de salida del módulo de Cartera (cartera@ferrealiadosjv.com en ColombiaHosting, SSL 465).
# La clave del buzón la guarda un Admin desde Configuración → Envío de cartera (se comprueba y se
# guarda cifrada con CIFRADO_CLAVE). SMTP_PASSWORD es opcional: si trae algo, tiene prioridad.
SMTP_HOST=s10863.mex1.stableserver.net
SMTP_PORT=465
SMTP_USER=cartera@ferrealiadosjv.com
SMTP_PASSWORD=
# Llave para cifrar secretos guardados en la BD. Generarla UNA vez en el servidor con
# `openssl rand -base64 32` y no cambiarla (si cambia, hay que volver a guardar la clave del correo).
CIFRADO_CLAVE=
